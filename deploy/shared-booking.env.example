# Template VPS prod — copier vers /home/ubuntu/docker/services/shared-booking.env
# Ne jamais commiter le vrai fichier. Voir deploy/setup-vps-env.sh.
BETTER_AUTH_SECRET=change-me-openssl-rand-base64-48
BETTER_AUTH_URL=https://shared-booking.guillaumejacquart.com

# Mailjet (vérifié)
SMTP_HOST=in-v3.mailjet.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=dev@guillaumejacquart.com

# Stripe live — webhook → https://shared-booking.guillaumejacquart.com/api/stripe/webhook
# Laisser vide pour désactiver les séances payantes (400 propre).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudflare R2 — bucket shared-booking-backups, token Object Read+Write
# Endpoint réel déjà créé (bucket + clé OK, testés le 2026-09-14).
# Vraies clés dans deploy/.env.vps-r2 (git-ignoré, chmod 600).
R2_ENDPOINT=https://c205393dcbcc035175cb8d159cd3ae52.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=shared-booking-backups
R2_PREFIX=sqlite
BACKUP_SCHEDULE=0 3 * * *
BACKUP_TIMEZONE=Europe/Paris
BACKUP_KEEP_LOCAL=7
BACKUP_ON_STARTUP=false
BACKUP_ENABLED=true
