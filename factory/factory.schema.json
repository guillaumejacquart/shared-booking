{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guillaumejacquart.com/software-factory/factory.schema.json",
  "title": "Software factory configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["factoryVersion", "checks"],
  "properties": {
    "factoryVersion": {
      "type": "integer",
      "const": 1
    },
    "profile": {
      "type": "string",
      "description": "Human-readable stack profile, for example next-sqlite."
    },
    "failFast": {
      "type": "boolean",
      "default": true,
      "description": "Stop after the first failing check."
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "run"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "run": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "comments": {
          "enum": ["block", "off"],
          "default": "block"
        },
        "suppressions": {
          "enum": ["block", "off"],
          "default": "block"
        },
        "baseline": {
          "type": "string",
          "minLength": 1,
          "description": "Git ref used as the CI floor, to grandfather existing work."
        },
        "extensions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "exclude": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
